  <name>T Code</name>
  <developer_name>Thinakaran Manokaran</developer_name>
  <summary>A lightweight text editor written in Lua</summary>
  <content_rating type="oars-1.0" />
  <launchable type="desktop-id">dev.thinakaran.tcode.desktop</launchable>

  <description>
    <p>
      T Code is a lightweight text editor and development tool written mainly
      in Lua, on top of a minimalistic C core using the SDL3 graphics library.
    </p>
  </description>

  <url type="homepage">https://thinakaran.dev/</url>

  <provides>
    <binary>tcode</binary>
  </provides>

